#!/bin/sh
# `ruby` shim used by the build scripts: the NativeScript CLI runs `ruby -e
# "require 'xcodeproj'"` to merge xcconfig files; this points it at the gem
# installed in ./.gems by scripts/setup.sh without changing GEM_PATH for any
# other tool (e.g. CocoaPods).
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
GEM_PATH="$ROOT/.gems${GEM_PATH:+:$GEM_PATH}" exec /usr/bin/ruby "$@"
