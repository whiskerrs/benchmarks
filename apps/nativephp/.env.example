APP_NAME=Everbloom
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=null
LOG_LEVEL=emergency

DB_CONNECTION=sqlite
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=array

# Default Storefront endpoint. iOS reads SHOP_API_URL from the process
# environment at launch; on Android set SHOP_API_URL here before building.
SHOP_API_URL=

NATIVEPHP_APP_ID=dev.whiskerrs.shopbench.nativephp
NATIVEPHP_APP_VERSION="1.0.0"
NATIVEPHP_APP_VERSION_CODE="1"
