{
    "name": "everbloom",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "start": "catalyst start",
        "build": "catalyst build",
        "serve": "catalyst serve",
        "lint": "eslint client server src",
        "bundle": "node scripts/bundle-web.mjs",
        "ios:device": "sh scripts/build-ios.sh device",
        "ios:sim": "sh scripts/build-ios.sh simulator",
        "ios:verify": "sh scripts/verify-ios.sh",
        "android:apk": "node scripts/bundle-web.mjs && cd android && ./gradlew assembleRelease"
    },
    "_moduleAliases": {
        "@api": "api.js",
        "@containers": "src/js/containers",
        "@server": "server",
        "@config": "config",
        "@css": "src/static/css",
        "@routes": "src/js/routes/"
    },
    "dependencies": {
        "catalyst-core": "1.2.1",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-router": "^7.18.2"
    },
    "devDependencies": {
        "eslint": "^8.26.0",
        "eslint-plugin-react": "^7.34.1",
        "eslint-plugin-react-hooks": "^4.6.0"
    },
    "overrides": {
        "react-helmet-async": {
            "react": "^16.6.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
            "react-dom": "^16.6.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
        }
    },
    "description": "Everbloom shop app (Catalyst)"
}
